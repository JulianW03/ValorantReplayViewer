{
  "version": {
    "config": 1,
    "app": "0.10.0-pre"
  },
  "filepaths": {
    "riot-games-folder": {
      "relativeToEnvVar": "LOCALAPPDATA",
      "path": [
        "Riot Games"
      ]
    },
    "valorant-saved": {
      "relativeToEnvVar": "LOCALAPPDATA",
      "path": [
        "VALORANT",
        "Saved"
      ]
    }
  },
  "configurations": {
    "app": {
      "port": 3000,
      "logging": {
        "levels": ["log", "error", "warn"],
        "max-log-files": 10
      },
      "additional-cors-origins": []
    },
    "valorant-version-read": {
      "regex": "CI server version: (\\S*)",
      "retry-timeout-ms": 5000
    }
  },
  "overrides": {
    "valorant-version-read": {},
    "valorant-api": {}
  }
}