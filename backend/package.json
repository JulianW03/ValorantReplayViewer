{
  "name": "vrv",
  "version": "1.0.0",
  "description": "Valorant Replay Viewer",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "generate": "openapi-generator-cli generate -g typescript-axios -i openapi/riot-client-openapi.json -o gen/ --global-property apiDocs=false,modelDocs=false",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "package:create-executable": "pkg . -t node24-win-x64 --output binaries/ValorantReplayViewer.exe",
    "package:patch-executable": "node scripts/patch-executable/main.mjs binaries/ValorantReplayViewer.exe",
    "package": "npm run package:create-executable && npm run package:patch-executable",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest run test/**/*.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/platform-ws": "^11.2.6",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.6",
    "@types/adm-zip": "^0.5.8",
    "@types/lodash": "^4.17.25",
    "@types/lodash.merge": "^4.6.9",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.22.0",
    "adm-zip": "^0.5.18",
    "axios": "1.18.1",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "drizzle-orm": "^0.45.3",
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1",
    "lodash.merge": "^4.6.2",
    "multer": "^2.4.0",
    "nest-winston": "^2.0.0",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "adm-zip": "^0.5.17",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "resedit": "^3.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "bin": "dist/src/main.js",
  "pkg": {
    "scripts": [
      "node_modules/drizzle-orm/**/*.cjs"
    ],
    "assets": [
      "dist/public/**/*",
      "dist/config.json",
      "dist/db/migrations/**/*",
      "node_modules/drizzle-orm/**/package.json",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ]
  }
}
